/div></section><section style="background:#FFFFFF"><div class="mx-auto max-w-7xl px-5 lg:px-8 py-24 md:py-28 grid gap-16 lg:grid-cols-2 lg:items-center"><div class="mx-auto w-[300px]" style="border:1px solid #E4E2DE;background:#FFFFFF;box-shadow:0 2px 12px rgba(0,0,0,0.06)"><div class="px-4 py-3 flex items-center justify-between" style="border-bottom:1px solid #E4E2DE"><span class="text-[15px] font-bold" style="color:#111110;letter-spacing:-0.03em">Cleard</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bell h-4 w-4" aria-hidden="true" style="color:#6B6860"><path d="M10.268 21a2 2 0 0 0 3.464 0"></path><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path></svg></div><div class="h-[420px] overflow-hidden" style="animation:clFade 400ms ease-out both"><div><div class="px-4 py-3" style="border-bottom:1px solid #EEECEA"><div class="flex items-center justify-between gap-2"><span class="text-[11px] font-semibold" style="color:#00B4A8">CLR-2026-0212</span><span class="px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.06em]" style="background:rgba(0,180,168,0.12);color:#00917F">Approved</span></div><div class="mt-1 text-[12.5px] truncate" style="color:#111110">14 Pelican Bay Ln, Naples</div><div class="text-[11px]" style="color:#6B6860">Collier County</div></div><div class="px-4 py-3" style="border-bottom:1px solid #EEECEA"><div class="flex items-center justify-between gap-2"><span class="text-[11px] font-semibold" style="color:#00B4A8">CLR-2026-0208</span><span class="px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.06em]" style="background:rgba(220,60,60,0.1);color:#C03030">Corrections</span></div><div class="mt-1 text-[12.5px] truncate" style="color:#111110">2840 SW 48th Ct, Miami</div><div class="text-[11px]" style="color:#6B6860">Miami-Dade</div></div><div class="px-4 py-3" style="border-bottom:1px solid #EEECEA"><div class="flex items-center justify-between gap-2"><span class="text-[11px] font-semibold" style="color:#00B4A8">CLR-2026-0204</span><span class="px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.06em]" style="background:rgba(0,0,0,0.06);color:#6B6860">In Review</span></div><div class="mt-1 text-[12.5px] truncate" style="color:#111110">901 Harbour Ct, Jupiter</div><div class="text-[11px]" style="color:#6B6860">Palm Beach</div></div><div class="px-4 py-3" style="border-bottom:1px solid #EEECEA"><div class="flex items-center justify-between gap-2"><span class="text-[11px] font-semibold" style="color:#00B4A8">CLR-2026-0199</span><span class="px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.06em]" style="background:rgba(0,95,163,0.1);color:#005fa3">Permit Issued</span></div><div class="mt-1 text-[12.5px] truncate" style="color:#111110">7720 NW 2nd Ave, Boca Raton</div><div class="text-[11px]" style="color:#6B6860">Palm Beach</div></div><div class="px-4 py-3" style="border-bottom:1px solid #EEECEA"><div class="flex items-center justify-between gap-2"><span class="text-[11px] font-semibold" style="color:#00B4A8">CLR-2026-0195</span><span class="px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.06em]" style="background:rgba(0,0,0,0.06);color:#6B6860">In Review</span></div><div class="mt-1 text-[12.5px] truncate" style="color:#111110">5612 SE Coconut Ter, Stuart</div><div class="text-[11px]" style="color:#6B6860">Martin County</div></div></div></div><div class="grid grid-cols-4" style="border-top:1px solid #E4E2DE;background:#F5F4F0"><div class="py-2.5 text-center" style="color:#111110;background:#EEECEA"><div class="text-[14px]">⊞</div><div class="text-[9.5px] uppercase tracking-[0.08em]">Permits</div></div><div class="py-2.5 text-center" style="color:#9E9B96;background:transparent"><div class="text-[14px]">✓</div><div class="text-[9.5px] uppercase tracking-[0.08em]">Inspections</div></div><div class="py-2.5 text-center" style="color:#9E9B96;background:transparent"><div class="text-[14px]">☑</div><div class="text-[9.5px] uppercase tracking-[0.08em]">Compliance</div></div><div class="py-2.5 text-center" style="color:#9E9B96;background:transparent"><div class="text-[14px]">☰</div><div class="text-[9.5px] uppercase tracking-[0.08em]">Documents</div></div></div></div><div><h2 style="font-size:clamp(2rem, 3.6vw, 2.875rem);line-height:1.08;letter-spacing:-0.035em"><span style="color:#6B6860;font-weight:600">Your whole permit office </span><span style="color:#111110;font-weight:800">in your pocket.</span></h2><div class="mt-10 space-y-7"><div class="flex gap-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-smartphone h-5 w-5 mt-0.5 shrink-0" aria-hidden="true" style="color:#00B4A8"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect><path d="M12 18h.01"></path></svg><div><div class="text-[15.5px] font-bold" style="color:#111110;letter-spacing:-0.02em">Live inspection tracking</div><p class="mt-1.5 text-[14px] leading-relaxed" style="color:#6B6860">Watch every inspection move from scheduled to passed, in real time, from the field.</p></div></div><div class="flex gap-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bell h-5 w-5 mt-0.5 shrink-0" aria-hidden="true" style="color:#00B4A8"><path d="M10.268 21a2 2 0 0 0 3.464 0"></path><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path></svg><div><div class="text-[15.5px] font-bold" style="color:#111110;letter-spacing:-0.02em">Instant alerts</div><p class="mt-1.5 text-[14px] leading-relaxed" style="color:#6B6860">Corrections, expirations, and approvals push straight to your phone the moment they happen.</p></div></div><div class="flex gap-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-open h-5 w-5 mt-0.5 shrink-0" aria-hidden="true" style="color:#00B4A8"><path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"></path></svg><div><div class="text-[15.5px] font-bold" style="color:#111110;letter-spacing:-0.02em">Documents on site</div><p class="mt-1.5 text-[14px] leading-relaxed" style="color:#6B6860">Permits, plans, COIs and inspection reports — available at the job, not back at the office.</p></div></div></div></div></div></section><section style="background:#F5F4F0;border-top:1px solid #E4E2DE"><div class="mx-auto max-w-7xl px-5 lg:px-8 py-24 md:py-28"><div class="text-[10.5px] uppercase tracking-[0.18em] font-bold" style="color:#00B4A8">How it works</div><h2 class="mt-6 max-w-3xl" style="font-size:clamp(2rem, 3.6vw, 2.875rem);line-height:1.08;letter-spacing:-0.035em"><span style="color:#111110;font-weight:800">Six steps. </span><span style="color:#6B6860;font-weight:600">Contract to certificate.</span></h2><div class="mt-14 grid gap-px sm:grid-cols-2 lg:grid-cols-6" style="background:#E4E2DE;border:1px solid #E4E2DE"><div class="p-5" style="background:#FFFFFF"><div class="text-[11px] font-bold tabular-nums" style="color:#00B4A8">01</div><div class="mt-3 text-[14.5px] font-bold" style="color:#111110;letter-spacing:-0.02em">Send the plans</div><p class="mt-2.5 text-[12.5px] leading-relaxed" style="color:#6B6860">Share drawings and scope. We intake, review, and prep for submission — including sub license and insurance collection.</p></div><div class="p-5" style="background:#FFFFFF"><div class="text-[11px] font-bold tabular-nums" style="color:#00B4A8">02</div><div class="mt-3 text-[14.5px] font-bold" style="color:#111110;letter-spacing:-0.02em">We submit</div><p class="mt-2.5 text-[12.5px] leading-relaxed" style="color:#6B6860">We submit through licensed private providers — bypassing county review queues and compressing your approval window.</p></div><div class="p-5" style="background:#FFFFFF"><div class="text-[11px] font-bold tabular-nums" style="color:#00B4A8">03</div><div class="mt-3 text-[14.5px] font-bold" style="color:#111110;letter-spacing:-0.02em">Manage corrections</div><p class="mt-2.5 text-[12.5px] leading-relaxed" style="color:#6B6860">If the building department flags issues, we handle it — drafting responses, coordinating revised drawings, resubmitting.</p></div><div class="p-5" style="background:#FFFFFF"><div class="text-[11px] font-bold tabular-nums" style="color:#00B4A8">04</div><div class="mt-3 text-[14.5px] font-bold" style="color:#111110;letter-spacing:-0.02em">Inspections coordinated</div><p class="mt-2.5 text-[12.5px] leading-relaxed" style="color:#6B6860">We schedule and confirm every required inspection. Your super gets the date, type, and what to have staged.</p></div><div class="p-5" style="background:#FFFFFF"><div class="text-[11px] font-bold tabular-nums" style="color:#00B4A8">05</div><div class="mt-3 text-[14.5px] font-bold" style="color:#111110;letter-spacing:-0.02em">Inspections approved</div><p class="mt-2.5 text-[12.5px] leading-relaxed" style="color:#6B6860">Each trade passes. We track every result, flag failures, and coordinate resolution before the next phase moves.</p></div><div class="p-5" style="background:#FFFFFF"><div class="text-[11px] font-bold tabular-nums" style="color:#00B4A8">06</div><div class="mt-3 text-[14.5px] font-bold" style="color:#111110;letter-spacing:-0.02em">Certificate of Occupancy</div><p class="mt-2.5 text-[12.5px] leading-relaxed" style="color:#6B6860">Final inspections clear. CO is issued. Full documentation stored in your portal — project closed, cleanly.</p></div></div></div></section><section style="background:#111110"><div class="mx-auto max-w-7xl px-5 lg:px-8 py-20 flex flex-col gap-8 md:flex-row md:items-center md:justify-between"><h2 class="max-w-xl" style="font-size:clamp(1.75rem, 3.2vw, 2.5rem);line-height:1.1;letter-spacing:-0.035em;color:#FFFFFF;font-weight:800">Stop running permits. Start building.</h2><div class="flex items-center gap-6"><a href="/join#request" style="background:#00B4A8;color:#111110" class="inline-flex items-center gap-2 px-6 py-3 text-[14px] font-bold no-underline">Get started <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a href="/product" style="color:rgba(255,255,255,0.72)" class="text-[14px] no-underline">See a demo →</a></div></div></section><footer style="background:#111110;border-top:1px solid rgba(255,255,255,0.12)"><div class="mx-auto max-w-7xl px-5 lg:px-8 py-12 flex flex-col gap-8 md:flex-row md:items-center md:justify-between"><a class="no-underline active" href="/" style="color:#FFFFFF;font-weight:700;font-size:18px;letter-spacing:-0.03em" data-status="active" aria-current="page">Cleard</a><nav class="flex flex-wrap items-center gap-x-8 gap-y-2 text-[13px]"><a href="/product" style="color:rgba(255,255,255,0.7)" class="no-underline">Product</a><a href="/join" style="color:rgba(255,255,255,0.7)" class="no-underline">Contractors</a><a href="https://floridianinc.com/privacy" class="no-underline" style="color:rgba(255,255,255,0.7)">Privacy</a><a href="https://floridianinc.com/terms" class="no-underline" style="color:rgba(255,255,255,0.7)">Terms</a></nav><div class="text-[12px]" style="color:rgba(255,255,255,0.5)">© 2026 Cleard</div></div></footer></div></div><script>(function(a,f){let l;try{l=JSON.parse(sessionStorage.getItem(a)||"{}")}catch{return}const n=l?.[f||history.state?.__TSR_key];let c=!1;for(const t in n){const e=n[t],o=e?.scrollX,s=e?.scrollY;if(Number.isFinite(o)&&Number.isFinite(s)){if(t==="window")scrollTo(o,s),c=!0;else if(t)try{const r=document.querySelector(t);r&&(r.scrollLeft=o,r.scrollTop=s)}catch{}}}if(c)return;const i=location.hash.slice(1);if(i){const t=history.state?.__hashScrollIntoViewOptions??!0;if(t){const e=document.getElementById(i);e&&e.scrollIntoView(t)}return}scrollTo(0,0)})("tsr-scroll-restoration-v1_3");document.currentScript.remove()</script><!--/$--><section aria-label="Notifications alt+T" tabindex="-1" aria-live="polite" aria-relevant="additions text" aria-atomic="false"></section><script class="$tsr" id="$tsr-stream-barrier">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]};$_TSR.router=($R=>$R[0]={manifest:$R[1]={routes:$R[2]={__root__:$R[3]={preloads:$R[4]=["/assets/index-BuwbwoLf.js"],scripts:$R[5]=[$R[6]={attrs:$R[7]={type:"module",async:!0,src:"/assets/index-BuwbwoLf.js"}}]},"/":$R[8]={preloads:$R[9]=["/assets/index-BvUQhtXy.js","/assets/marketing-mockups-BoL-xW_4.js","/assets/send-AQRRXrhE.js","/assets/file-check-corner-C0Ba0MWe.js","/assets/shield-check-CzDFc7cX.js","/assets/users-DpiCwaQE.js","/assets/scale-ClHiqOcC.js","/assets/arrow-up-right-hikOF9wM.js","/assets/sparkles-CqiN1q31.js","/assets/bell-UT6cmA0o.js","/assets/folder-open-_UApboat.js","/assets/arrow-right-BM5DETK-.js"]}}},matches:$R[10]=[$R[11]={i:"__root__␀",u:1787220514143,s:"success",ssr:!0},$R[12]={i:"␀␀",u:1787220514143,s:"success",ssr:!0}],lastMatchId:"␀␀"})($R["tsr"]);$_TSR.e();document.currentScript.remove()</script><script type="modul