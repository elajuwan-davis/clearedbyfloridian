der-top:1px solid rgba(245,244,240,0.12)"><div class="text-[26px] md:text-[32px] font-bold leading-none tabular-nums" style="color:#F5F4F0;letter-spacing:-0.04em">400+</div><div class="mt-2.5 text-[10.5px] uppercase tracking-[0.16em]" style="color:#00B4A8">Jurisdictions covered</div></div></div></div></section><section style="background:#F5F4F0;border-top:1px solid #E4E2DE;border-bottom:1px solid #E4E2DE"><div class="mx-auto max-w-7xl px-5 lg:px-8 py-24 md:py-28 text-center"><div class="text-[10.5px] uppercase tracking-[0.18em] font-bold" style="color:#00B4A8">What we run for you</div><h2 class="mt-6 mx-auto max-w-3xl" style="font-size:clamp(2rem, 3.6vw, 2.875rem);line-height:1.08;letter-spacing:-0.035em"><span style="color:#6B6860;font-weight:600">Every moving part. </span><span style="color:#111110;font-weight:800">From signed contract to CO.</span></h2><p class="mt-5 mx-auto max-w-2xl text-[16px] leading-relaxed" style="color:#6B6860">Most back offices juggle 6–8 vendors to get a project through. Cleard replaces all of them.</p><div class="hidden lg:block relative mx-auto mt-16" style="width:720px;height:720px"><div class="absolute inset-0" style="animation:clSpin 60s linear infinite"><div class="absolute -translate-x-1/2 -translate-y-1/2 px-4 py-3 text-[12.5px] font-semibold w-[190px]" style="left:360px;top:60px;background:#FFFFFF;border:1px solid #E4E2DE;color:#111110;animation:clSpin 60s linear infinite reverse">Permit Submission</div><div class="absolute -translate-x-1/2 -translate-y-1/2 px-4 py-3 text-[12.5px] font-semibold w-[190px]" style="left:572.1320343559643px;top:147.86796564403576px;background:#FFFFFF;border:1px solid #E4E2DE;color:#111110;animation:clSpin 60s linear infinite reverse">Private Provider Plan Review</div><div class="absolute -translate-x-1/2 -translate-y-1/2 px-4 py-3 text-[12.5px] font-semibold w-[190px]" style="left:660px;top:360px;background:#FFFFFF;border:1px solid #E4E2DE;color:#111110;animation:clSpin 60s linear infinite reverse">Correction Management</div><div class="absolute -translate-x-1/2 -translate-y-1/2 px-4 py-3 text-[12.5px] font-semibold w-[190px]" style="left:572.1320343559643px;top:572.1320343559643px;background:#FFFFFF;border:1px solid #E4E2DE;color:#111110;animation:clSpin 60s linear infinite reverse">Inspection Scheduling</div><div class="absolute -translate-x-1/2 -translate-y-1/2 px-4 py-3 text-[12.5px] font-semibold w-[190px]" style="left:360px;top:660px;background:#FFFFFF;border:1px solid #E4E2DE;color:#111110;animation:clSpin 60s linear infinite reverse">Subcontractor Coordination</div><div class="absolute -translate-x-1/2 -translate-y-1/2 px-4 py-3 text-[12.5px] font-semibold w-[190px]" style="left:147.86796564403576px;top:572.1320343559643px;background:#FFFFFF;border:1px solid #E4E2DE;color:#111110;animation:clSpin 60s linear infinite reverse">License Verification</div><div class="absolute -translate-x-1/2 -translate-y-1/2 px-4 py-3 text-[12.5px] font-semibold w-[190px]" style="left:60px;top:360.00000000000006px;background:#FFFFFF;border:1px solid #E4E2DE;color:#111110;animation:clSpin 60s linear infinite reverse">Insurance &amp; COI Tracking</div><div class="absolute -translate-x-1/2 -translate-y-1/2 px-4 py-3 text-[12.5px] font-semibold w-[190px]" style="left:147.8679656440357px;top:147.86796564403576px;background:#FFFFFF;border:1px solid #E4E2DE;color:#111110;animation:clSpin 60s linear infinite reverse">Document Management</div></div><div class="cl-dot absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 grid place-items-center" style="width:220px;height:220px;background:#111110;border-radius:999px"><div class="text-center"><div class="text-[22px] font-bold" style="color:#FFFFFF;letter-spacing:-0.03em">Cleard</div><div class="mt-1 text-[10.5px] uppercase tracking-[0.16em]" style="color:#00B4A8">Back office</div></div></div></div><div class="lg:hidden mt-12 grid grid-cols-1 sm:grid-cols-2 gap-3 text-left"><div class="px-4 py-3 text-[13px] font-semibold" style="background:#FFFFFF;border:1px solid #E4E2DE;color:#111110">Permit Submission</div><div class="px-4 py-3 text-[13px] font-semibold" style="background:#FFFFFF;border:1px solid #E4E2DE;color:#111110">Private Provider Plan Review</div><div class="px-4 py-3 text-[13px] font-semibold" style="background:#FFFFFF;border:1px solid #E4E2DE;color:#111110">Correction Management</div><div class="px-4 py-3 text-[13px] font-semibold" style="background:#FFFFFF;border:1px solid #E4E2DE;color:#111110">Inspection Scheduling</div><div class="px-4 py-3 text-[13px] font-semibold" style="background:#FFFFFF;border:1px solid #E4E2DE;color:#111110">Subcontractor Coordination</div><div class="px-4 py-3 text-[13px] font-semibold" style="background:#FFFFFF;border:1px solid #E4E2DE;color:#111110">License Verification</div><div class="px-4 py-3 text-[13px] font-semibold" style="background:#FFFFFF;border:1px solid #E4E2DE;color:#111110">Insurance &amp; COI Tracking</div><div class="px-4 py-3 text-[13px] font-semibold" style="background:#FFFFFF;border:1px solid #E4E2DE;color:#111110">Document Management</div></div></div></section><section style="background:#FFFFFF;border-bottom:1px solid #E4E2DE"><div class="mx-auto max-w-7xl px-5 lg:px-8 py-14"><div class="text-[10.5px] uppercase tracking-[0.16em] font-bold" style="color:#9E9B96">Cleard by the numbers</div><div class="mt-8 grid gap-10 md:grid-cols-3"><div><div class="text-[44px] font-bold tabular-nums leading-none" style="color:#111110;letter-spacing:-0.04em">0</div><div class="mt-2 text-[13.5px]" style="color:#6B6860">Permits submitted — and counting</div></div><div><div class="text-[44px] font-bold tabular-nums leading-none" style="color:#111110;letter-spacing:-0.04em">2<!-- --> <span class="text-[24px] font-semibold">days</span></div><div class="mt-2 text-[13.5px]" style="color:#6B6860;animation:clFade 500ms ease-out both">Avg. approval time — <!-- -->Gas permit</div></div><div><div class="text-[44px] font-bold tabular-nums leading-none" style="color:#111110;letter-spacing:-0.04em">0<!-- -->%</div><div class="mt-2 text-[13.5px]" style="color:#6B6860">On-time submission rate</div></div></div></div></section><section style="background:#FFFFFF"><div class="mx-auto max-w-7xl px-5 lg:px-8 py-24 md:py-28"><h2 class="max-w-3xl" style="font-size:clamp(2rem, 3.6vw, 2.875rem);line-height:1.08;letter-spacing:-0.035em"><span style="color:#111110;font-weight:800">One team runs it all. </span><span style="color:#6B6860;font-weight:600">So yours doesn&#x27;t have to.</span></h2><p class="mt-5 max-w-2xl text-[16px] leading-relaxed" style="color:#6B6860">Most contractors spread this across 4–6 vendors, two admins, and a lot of phone calls. Cleard consolidates the entire compliance and administrative operation — under one roof, in one portal.</p><div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-6"><div class="relative p-6 lg:p-7 lg:col-span-3" style="background:#F5F4F0;border:1px solid #E4E2DE"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right absolute right-5 top-5 h-4 w-4" aria-hidden="true" style="color:#9E9B96"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="inline-flex h-11 w-11 items-center justify-center" style="background:#0C0D0B"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send h-[19px] w-[19px]" aria-hidden="true" style="color:#00B4A8"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path><path d="m21.854 2.147-10.94 10.939"></path></svg></span><h3 class="mt-5 font-bold text-[19px]" style="color:#111110;letter-spacing:-0.02em">Permitting Administration</h3><p class="mt-3 text-[14px] leading-relaxed" style="color:#6B6860">Full-service permit management — application, submission, tracking, corrections, and certificate of occupancy, handled end to end.</p><span class="mt-5 inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.06em]" style="background:rgba(0,180,168,0.12);color:#00917F">Core service</span></div><div class="relative p-6 lg:p-7 lg:col-span-3" style="background:#F5F4F0;border:1px solid #E4E2DE"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right absolute right-5 top-5 h-4 w-4" aria-hidden="true" style="color:#9E9B96"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="inline-flex h-11 w-11 items-center justify-center" style="background:#0C0D0B"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-check-corner h-[19px] w-[19px]" aria-hidden="true" style="color:#00B4A8"><path d="M10.5 22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v6"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="m14 20 2 2 4-4"></path></svg></span><h3 class="mt-5 font-bold text-[19px]" style="color:#111110;letter-spacing:-0.02em">Private Plan Review &amp; Inspections</h3><p class="mt-3 text-[14px] leading-relaxed" style="color:#6B6860">Faster approvals through licensed private providers. Plan review and field inspections performed by certified professionals, not municipal backlogs.</p><span class="mt-5 inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.06em]" style="background:rgba(0,180,168,0.12);color:#00917F">Speeds approval</span></div><div class="relative p-6 lg:p-7 lg:col-span-2" style="background:#F5F4F0;border:1px solid #E4E2DE"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right absolute right-5 top-5 h-4 w-4" aria-hidden="true" style="color:#9E9B96"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="inline-flex h-11 w-11 items-center justify-center" style="background:#0C0D0B"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check h-[19px] w-[19px]" aria-hidden="true" style="color:#00B4A8"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg></span><h3 class="mt-5 font-bold text-[17px]" style="color:#111110;letter-spacing:-0.02em">Contractor License Management</h3><p class="mt-3 text-[14px] leading-relaxed" style="color:#6B6860">License verification, renewal tracking, CE hour monitoring, and qualifying agent oversight — all in one dashboard.</p><span class="mt-5 inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.06em]" style="background:rgba(0,180,168,0.12);color:#00917F">Active monitoring</span></div><div class="relative p-6 lg:p-7 lg:col-span-2" style="background:#F5F4F0;border:1px solid #E4E2DE"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right absolute right-5 top-5 h-4 w-4" aria-hidden="true" style="color:#9E9B96"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="inline-flex h-11 w-11 items-center justify-center" style="background:#0C0D0B"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users h-[19px] w-[19px]" aria-hidden="true" style="color:#00B4A8"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg></span><h3 class="mt-5 font-bold text-[17px]" style="color:#111110;letter-spacing:-0.02em">Insurance Compliance</h3><p class="mt-3 text-[14px] leading-relaxed" style="color:#6B6860">Certificate of insurance collection, coverage validation, expiration tracking, and automated follow-up for your entire subcontractor roster.</p><span class="mt-5 inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.06em]" style="background:rgba(0,180,168,0.12);color:#00917F">COI management</span></div><div class="relative p-6 lg:p-7 lg:col-span-2" style="background:#F5F4F0;border:1px solid #E4E2DE"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right absolute right-5 top-5 h-4 w-4" aria-hidden="true" style="color:#9E9B96"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="inline-flex h-11 w-11 items-center justify-center" style="background:#0C0D0B"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scale h-[19px] w-[19px]" aria-hidden="true" style="color:#00B4A8"><path d="M12 3v18"></path><path d="m19 8 3 8a5 5 0 0 1-6 0zV7"></path><path d="M3 7h1a17 17 0 0 0 8-2 17 17 0 0 0 8 2h1"></path><path d="m5 8 3 8a5 5 0 0 1-6 0zV7"></path><path d="M7 21h10"></path></svg></span><h3 class="mt-5 font-bold text-[17px]" style="color:#111110;letter-spacing:-0.02em">Lien Rights</h3><p class="mt-3 text-[14px] leading-relaxed" style="color:#6B6860">Notice of Commencement, Preliminary Notices, Lien Waivers, and statutory deadline tracking — generated, signed, and recorded without leaving the platform.</p><span class="mt-5 inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.06em]" style="background:rgba(0,180,168,0.12);color:#00917F">Statutory deadlines</span></div></div></div></section><section style="background:#111310"><div class="mx-auto max-w-7xl px-5 lg:px-8 py-24 md:py-32"><div class="text-[10.5px] font-bold uppercase tracking-[0.2em]" style="color:#00B4A8">How it works</div><h2 class="mt-6 max-w-3xl" style="font-size:clamp(2rem, 3.8vw, 3rem);line-height:1.06;letter-spacing:-0.035em"><span style="color:#F5F4F0;font-weight:800">Submit. Track. Close. </span><span style="color:rgba(245,244,240,0.56);font-weight:600">That&#x27;s your part.</span></h2><div class="mt-16 space-y-16 md:space-y-24"><div class="grid gap-10 lg:grid-cols-12 lg:items-center"><div class="lg:col-span-4 "><div class="inline-flex h-12 w-12 items-center justify-center text-[15px] font-bold tabular-nums" style="background:#00B4A8;color:#0C0D0B">01</div><h3 class="mt-6 font-bold" style="color:#F5F4F0;font-size:clamp(1.5rem, 2.4vw, 2rem);letter-spacing:-0.03em">Submit</h3><p class="mt-4 text-[15px] leading-relaxed" style="color:rgba(245,244,240,0.56)">Send scope and drawings once. We build the application, run the document checklist, and file it.</p></div><div class="lg:col-span-8 "><div class="relative w-full overflow-hidden" style="background:#111310;border:1px solid rgba(245,244,240,0.12);box-shadow:0 40px 90px -40px rgba(0,0,0,0.85)"><div class="flex items-center gap-3 px-3 py-2.5" style="background:#0C0D0B;border-bottom:1px solid rgba(245,244,240,0.12)"><div class="flex items-center gap-1.5"><span class="h-2 w-2" style="background:rgba(245,244,240,0.22);border-radius:999px"></span><span class="h-2 w-2" style="background:rgba(245,244,240,0.16);border-radius:999px"></span><span class="h-2 w-2" style="background:rgba(245,244,240,0.12);border-radius:999px"></span></div><div class="flex-1 truncate px-3 py-1 text-[10.5px]" style="background:#111310;border:1px solid rgba(245,244,240,0.07);color:rgba(245,244,240,0.34)">app.cleard.io/permits/new</div></div><div class=""><div class="grid grid-cols-[1fr] sm:grid-cols-[148px_1fr]"><div class="hidden sm:block py-3" style="background:#0C0D0B;border-right:1px solid rgba(245,244,240,0.12)"><div class="px-4 pb-4 text-[14px] font-bold" style="color:#F5F4F0;letter-spacing:-0.03em">Cleard</div><div class="px-4 py-[7px] text-[11.5px]" style="color:#F5F4F0;font-weight:600;background:#171A16;border-left:2px solid #00B4A8">Permits</div><div class="px-4 py-[7px] text-[11.5px]" style="color:rgba(245,244,240,0.56);border-left:2px solid transparent">Inspections</div><div class="px-4 py-[7px] text-[11.5px]" style="color:rgba(245,244,240,0.56);border-left:2px solid transparent">Licenses</div><div class="px-4 py-[7px] text-[11.5px]" style="color:rgba(245,244,240,0.56);border-left:2px solid transparent">Insurance</div><div class="px-4 py-[7px] text-[11.5px]" style="color:rgba(245,244,240,0.56);border-left:2px solid transparent">Lien Rights</div><div class="px-4 py-[7px] text-[11.5px]" style="color:rgba(245,244,240,0.56);border-left:2px solid transparent">Documents</div></div><div class="min-w-0"><div><div class="flex items-center justify-between gap-3 px-4 py-3" style="border-bottom:1px solid rgba(245,244,240,0.12)"><span class="text-[12.5px] font-semibold" style="color:#F5F4F0">New permit application</span><span class="px-2.5 py-1 text-[10.5px] font-bold" style="background:#00B4A8;color:#0C0D0B">Submit</span></div><div class="p-4 space-y-3"><div><div class="text-[9.5px] font-bold uppercase tracking-[0.14em]" style="color:rgba(245,244,240,0.34)">Project address</div><div class="mt-1.5 px-3 py-2 text-[12px]" style="background:#171A16;border:1px 